  "reference_distributions": {
    "concept_scores": "z = (score - mean) / SD over clean, QC-passing tiles of the 218 training images; 'above normal' means above the training-image average for that feature, not a population norm",
    "ood_percentile": "mean cosine distance of a read's tiles to their k = 10 nearest TTA-averaged training tiles (CONCH), expressed as a percentile of the 50 clean calibration images",
    "similar_cases": "k = 5 nearest training images by cosine similarity of the mean CONCH embedding; the library is the 218 training images only, so a test image never retrieves itself or another test image",
    "look_alike": "the nearest training image whose label differs from the predicted class",
    "temperature": "fit on out-of-fold logits of the training images",
    "conformal_threshold": "fit on the 50 calibration images",
    "margin_threshold": "from 30 benign calibration images (simulated margin read)"
  },
  "components": {
    "pretrained_frozen": {
      "UNI2-h (MahmoodLab/UNI2-h)": "production image encoder",
