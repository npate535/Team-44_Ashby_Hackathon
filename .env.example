# PathQueue environment template. Copy to .env (git-ignored) or keep values in ~/.config/ashby-2026/*.env (mode 0600).
# Never commit real values; never put keys under /work/nvme or /projects (event-readable).

# Lumen (NCSA, OpenAI-compatible) — offline summaries/agent rationales only; the live demo makes zero LLM calls.
LUMEN_API_KEY=
LUMEN_BASE_URL=https://lumen.ncsa.illinois.edu/v1

# Hosted organizer model servers (callable only from inside Delta; 5-tile equivalence check only).
CONCH_URL=
CONCH_API_KEY=
MUSK_URL=
MUSK_API_KEY=

# Roots (optional overrides; see core/config.py). Relative paths resolve against the repo root.
PATHQUEUE_SITE=
PATHQUEUE_DATA_ROOT=
PATHQUEUE_ARTIFACTS_ROOT=
# Backend: load case JSONs from this folder instead of <artifacts>/cases (e.g. fixtures).
PATHQUEUE_CASES_DIR=

# Hugging Face cache: private home directory, never /work/nvme (BUILD_PLAN §A20).
HF_HOME=~/.cache/huggingface

# Evidence in plain language (backend/interpret.py): Cursor agent CLI, headless, read-only "ask" mode. Cached under
# <artifacts>/interpretations/. Model default gemini-4-argon-high; see `cursor-agent --list-models`.
CURSOR_API_KEY=
# Optional second key, tried once when a call with the primary key fails.
CURSOR_API_KEY_BACKUP=
PATHQUEUE_INTERPRET_MODEL=
